# Public application origin used for OAuth redirect and CSRF Origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub App user authorization (configure callback URL as NEXT_PUBLIC_APP_URL/api/github/callback).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# Supabase project API. The service role key is server-only and must never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generate independent random values. Token key is base64 for exactly 32 random bytes.
CODEDNA_TOKEN_ENCRYPTION_KEY=
CODEDNA_SESSION_SECRET=

# Optional background worker polling interval in milliseconds.
GITHUB_WORKER_POLL_MS=4000
